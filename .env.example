# =============================================================
# INEXCI FRONTEND — Variáveis de Ambiente
#
#   cp .env.example .env.local
#
# Só a primeira é necessária para rodar em dev. As variáveis NEXT_PUBLIC_*
# são lidas no build: depois de mudar, reinicie o `yarn dev` (ou refaça o build).
# =============================================================

# ---- OBRIGATÓRIA: URL da API (sem barra final)
NEXT_PUBLIC_API_URL=http://localhost:3002

# ---- OPCIONAL: captcha do cadastro (Cloudflare Turnstile).
# Vazio = cadastro sem captcha. Anda junto com TURNSTILE_SECRET_KEY da API.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- OPCIONAL: URLs da landing page (SEO e redirecionamento site → app).
# Em produção: https://inexci.com.br e https://app.inexci.com.br.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
